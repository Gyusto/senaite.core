<?xml version="1.0"?>
<dc-workflow xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             workflow_id="senaite_billing_workflow"
             title="Senaite Billing Invoice Workflow"
             description=""
             state_variable="review_state"
             initial_state="draft"
             manager_bypass="False"
             i18n:domain="senaite.core">

  <!--
  Lifecycle of a billing Invoice:
    draft  (issue)  to issued  (pay)  to paid
    draft/issued  (cancel)  to cancelled  (reinstate)  to draft

  Guards are dispatched by convention to
  bika.lims.workflow.billinginvoice.guards.guard_[transition_id]; when that
  module/function is absent the transition is allowed. Side-effects, if any,
  are dispatched to bika.lims.workflow.billinginvoice.events.after_[id].
  -->

  <!-- PERMISSIONS -->
  <permission>Access contents information</permission>
  <permission>Delete objects</permission>
  <permission>List folder contents</permission>
  <permission>Modify portal content</permission>
  <permission>View</permission>
  <permission>senaite.core: Manage Billing</permission>

  <!-- State: draft (initial) -->
  <state state_id="draft" title="Draft" i18n:attributes="title">
    <exit-transition transition_id="issue"/>
    <exit-transition transition_id="cancel"/>

    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Delete objects" acquired="True"/>
    <permission-map name="List folder contents" acquired="True"/>
    <permission-map name="Modify portal content" acquired="True"/>
    <permission-map name="View" acquired="True"/>
    <permission-map name="senaite.core: Manage Billing" acquired="True"/>
  </state>

  <!-- State: issued -->
  <state state_id="issued" title="Issued" i18n:attributes="title">
    <exit-transition transition_id="pay"/>
    <exit-transition transition_id="cancel"/>

    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Delete objects" acquired="False"/>
    <permission-map name="List folder contents" acquired="True"/>
    <permission-map name="Modify portal content" acquired="True"/>
    <permission-map name="View" acquired="True"/>
    <permission-map name="senaite.core: Manage Billing" acquired="True"/>
  </state>

  <!-- State: paid -->
  <state state_id="paid" title="Paid" i18n:attributes="title">
    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Delete objects" acquired="False"/>
    <permission-map name="List folder contents" acquired="True"/>
    <permission-map name="Modify portal content" acquired="False"/>
    <permission-map name="View" acquired="True"/>
    <permission-map name="senaite.core: Manage Billing" acquired="True"/>
  </state>

  <!-- State: cancelled -->
  <state state_id="cancelled" title="Cancelled" i18n:attributes="title">
    <exit-transition transition_id="reinstate"/>

    <permission-map name="Access contents information" acquired="True"/>
    <permission-map name="Delete objects" acquired="True"/>
    <permission-map name="List folder contents" acquired="True"/>
    <permission-map name="Modify portal content" acquired="True"/>
    <permission-map name="View" acquired="True"/>
    <permission-map name="senaite.core: Manage Billing" acquired="True"/>
  </state>

  <!-- Transition: issue -->
  <transition transition_id="issue" title="Issue" new_state="issued"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Issue</action>
    <guard>
      <guard-permission>senaite.core: Manage Billing</guard-permission>
      <guard-expression>python:here.guard_handler("issue")</guard-expression>
    </guard>
  </transition>

  <!-- Transition: pay -->
  <transition transition_id="pay" title="Pay" new_state="paid"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Pay</action>
    <guard>
      <guard-permission>senaite.core: Manage Billing</guard-permission>
      <guard-expression>python:here.guard_handler("pay")</guard-expression>
    </guard>
  </transition>

  <!-- Transition: cancel -->
  <transition transition_id="cancel" title="Cancel" new_state="cancelled"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Cancel</action>
    <guard>
      <guard-permission>senaite.core: Manage Billing</guard-permission>
      <guard-expression>python:here.guard_handler("cancel")</guard-expression>
    </guard>
  </transition>

  <!-- Transition: reinstate -->
  <transition transition_id="reinstate" title="Reinstate" new_state="draft"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Reinstate</action>
    <guard>
      <guard-permission>senaite.core: Manage Billing</guard-permission>
      <guard-expression>python:here.guard_handler("reinstate")</guard-expression>
    </guard>
  </transition>

  <variable variable_id="action" for_catalog="False" for_status="True" update_always="True">
    <description>Previous transition</description>
    <default>
      <expression>transition/getId|nothing</expression>
    </default>
    <guard>
    </guard>
  </variable>

  <variable variable_id="actor" for_catalog="False" for_status="True" update_always="True">
    <description>The ID of the user who performed the last transition</description>
    <default>
      <expression>user/getId</expression>
    </default>
    <guard>
    </guard>
  </variable>

  <variable variable_id="comments" for_catalog="False" for_status="True" update_always="True">
    <description>Comment about the last transition</description>
    <default>
      <expression>python:state_change.kwargs.get('comment', '')</expression>
    </default>
    <guard>
    </guard>
  </variable>

  <variable variable_id="review_history" for_catalog="False" for_status="False" update_always="False">
    <description>Provides access to workflow history</description>
    <default>
      <expression>state_change/getHistory</expression>
    </default>
    <guard>
    </guard>
  </variable>

  <variable variable_id="time" for_catalog="False" for_status="True" update_always="True">
    <description>When the previous transition was performed</description>
    <default>
      <expression>state_change/getDateTime</expression>
    </default>
    <guard>
    </guard>
  </variable>

</dc-workflow>
